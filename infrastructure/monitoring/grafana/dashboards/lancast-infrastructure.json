{
  "uid": "lancast-infrastructure",
  "title": "LANCAST — Host, Container, DB & Worker Telemetry",
  "tags": ["lancast", "infrastructure", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Host CPU Utilization (%)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Host Memory Utilization (%)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Root Disk Utilization (%)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker Judge0 Sandbox Health",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [{ "expr": "min(lancast_worker_judge0_up)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "UNHEALTHY", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container Memory Usage (cAdvisor)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "topk(10, container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container CPU Usage (cores, cAdvisor)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL Active Connections & Redis Memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{datname=\"lancast\"})",
          "legendFormat": "PG connections",
          "refId": "A"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Redis clients",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Execution Worker Job Throughput & P95 Duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "lancast-prometheus" },
      "targets": [
        {
          "expr": "sum by (language, status) (rate(lancast_worker_jobs_total[2m]))",
          "legendFormat": "jobs/s {{language}} ({{status}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, language) (rate(lancast_worker_job_duration_seconds_bucket[5m])))",
          "legendFormat": "P95 dur {{language}}",
          "refId": "B"
        }
      ]
    }
  ]
}
