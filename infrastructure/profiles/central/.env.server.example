# LANCAST Central Server Environment Template (DEP-01, DEP-07)
# Copy to `.env` on the central campus server and replace all placeholders.

ENVIRONMENT=production
DEPLOYMENT_PROFILE=central
PUBLIC_BASE_URL=https://lancast.campus.local
LOG_LEVEL=INFO
API_REPLICAS=2

# Authoritative PostgreSQL (local container by default; or set external DATABASE_URL)
POSTGRES_DB=lancast
POSTGRES_USER=lancast
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://lancast:replace-with-strong-postgres-password@postgres:5432/lancast

# Redis broker
REDIS_URL=redis://redis:6379/0

# Local FastAPI Auth (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=replace-with-64-char-hex-auth-secret-from-openssl-rand
SESSION_TTL_MINUTES=480

# Shared worker secret (must match .env.worker on remote worker nodes)
WORKER_SHARED_SECRET=replace-with-64-char-hex-worker-secret-from-openssl
EXECUTION_QUEUE_MAX_DEPTH=1000

# Gateway ports (candidate/organizer LAN on :80/:443; dedicated worker port on WORKER_BIND_IP)
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
WORKER_BIND_IP=10.10.0.10
GATEWAY_WORKER_PORT=8081
REDIS_WORKER_PORT=6379
