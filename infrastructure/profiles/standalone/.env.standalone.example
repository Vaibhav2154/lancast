# LANCAST Standalone Profile Environment Template (DEP-02, DEP-07)
# Copy to `.env` in repository root and replace all placeholder secrets before launching.

ENVIRONMENT=production
DEPLOYMENT_PROFILE=standalone
PUBLIC_BASE_URL=https://lancast.local
LOG_LEVEL=INFO

# Local PostgreSQL (authoritative data store + local FastAPI auth)
POSTGRES_DB=lancast
POSTGRES_USER=lancast
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://lancast:replace-with-strong-postgres-password@postgres:5432/lancast

# Local Redis
REDIS_URL=redis://redis:6379/0

# Local FastAPI Auth (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=replace-with-64-char-hex-auth-secret-from-openssl-rand
SESSION_TTL_MINUTES=480

# Execution worker secret (generate with: openssl rand -hex 32)
WORKER_SHARED_SECRET=replace-with-64-char-hex-worker-secret-from-openssl
EXECUTION_QUEUE_MAX_DEPTH=500

# Local Judge0 DB password
JUDGE0_DB_PASSWORD=replace-with-judge0-db-password

# Gateway ports
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
