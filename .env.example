# LANCAST Environment Configuration (Template — copy to .env and replace placeholders)
# NEVER commit .env or real secrets to version control (DEP-07).

ENVIRONMENT=development
DEPLOYMENT_PROFILE=standalone
PUBLIC_BASE_URL=http://localhost
LOG_LEVEL=INFO

# Local PostgreSQL (default). To use an external Postgres (e.g. Supabase DB URL),
# update DATABASE_URL while keeping authentication strictly local in FastAPI.
POSTGRES_DB=lancast
POSTGRES_USER=lancast
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+asyncpg://lancast:change-me-local-postgres-password@postgres:5432/lancast

# Local Redis (queue/cache)
REDIS_URL=redis://redis:6379/0

# Local FastAPI Auth Secret (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=change-me-generate-a-long-random-secret-key
SESSION_TTL_MINUTES=480

# Shared secret for execution workers -> API result callback (generate with: openssl rand -hex 32)
WORKER_SHARED_SECRET=change-me-generate-a-long-random-worker-secret

# Safety bounds & Judge0 DB
EXECUTION_QUEUE_MAX_DEPTH=500
JUDGE0_DB_PASSWORD=change-me-judge0-db-password

# Gateway ports
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Monitoring (operator-only loopback by default; NFR-SEC-03)
MONITORING_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
